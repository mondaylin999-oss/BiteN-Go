# ===========================================================================
#  BiteN Go — backend configuration
#  Copy this file to ".env" (same folder) and edit the values.
#      Windows PowerShell:  copy .env.example .env
#      macOS / Linux:       cp .env.example .env
# ===========================================================================

# --- PostgreSQL -------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# IMPORTANT — special characters in the password must be percent-encoded,
# otherwise the URL is parsed wrongly and you get a login failure:
#     #  ->  %23      @  ->  %40      /  ->  %2F
#     :  ->  %3A      ?  ->  %3F      %  ->  %25
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/biten_go_db

# --- Sessions ---------------------------------------------------------------
# Signs the login tokens. Generate a long random one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=1440

# --- Server -----------------------------------------------------------------
PORT=8000
# 0.0.0.0 makes the API reachable from other devices on your Wi-Fi.
HOST=0.0.0.0

# Comma separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Any private/LAN address is additionally allowed by default, so opening the
# app from your phone on the same Wi-Fi needs no configuration. Set this to an
# empty value before publishing on the internet.
# CORS_ORIGIN_REGEX=

# --- Seeding ----------------------------------------------------------------
# Creates the starter admin / agent / student / driver accounts and a small
# demo menu + ferry route on startup. Set to false once you have real data.
SEED_ON_START=true
# The password given to every seeded account.
SEED_PASSWORD=biten123

# --- C++ engine -------------------------------------------------------------
# Path to the compiled engine. Leave empty to use the default location
# (backend/cpp/build/biten_engine). Build it with:  bash cpp/build.sh
# BITEN_ENGINE_PATH=
# Set to true to refuse to start when the C++ engine is missing, instead of
# falling back to the TypeScript implementation of the same rules.
BITEN_ENGINE_REQUIRED=false

# --- Brute-force protection -------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
