# Optional. The app finds the backend by itself (see src/lib/api.ts): it tries
# the Vite proxy on the same address as the page, then <page host>:8000, then
# localhost:8000, and keeps whichever answers /health.
#
# Set this only when the API lives somewhere fixed, e.g. in production:
# VITE_API_URL=http://192.168.1.42:8000

# Used by vite.config.ts to point the dev proxy at a backend on another machine.
# VITE_BACKEND_URL=http://127.0.0.1:8000
